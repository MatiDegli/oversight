{"seq":12,"ts":"2026-10-27T14:03:21.915Z","type":"change.updated","payload":{"change_id":"change-1","agent_id":"agent-1","author":"agent","file":{"path":"shop/pricing.py","status":"modified","original":"\"\"\"Pricing rules: bulk discounts, coupons, tax and shipping. Amounts are in cents.\"\"\"\n\nfrom functools import lru_cache\n\n# (minimum quantity, percent off), highest tier first.\nBULK_TIERS = ((50, 20), (10, 10))\nTAX_PERCENT = 8\nFLAT_SHIPPING = 599\nFREE_SHIPPING_FROM = 10_000\n\n_COUPONS = {\"WELCOME5\": 5, \"SPRING10\": 10}\n\n\ndef compute_price(unit_price: int, quantity: int, extra_percent: int = 0) -> int:\n    \"\"\"Price of `quantity` units: the bulk tier and `extra_percent` are both taken off.\"\"\"\n    base = unit_price * quantity\n    percent = extra_percent\n    for minimum, tier_percent in BULK_TIERS:\n        if quantity >= minimum:\n            percent += tier_percent\n            break\n    return base - base * percent // 100\n\n\ndef price_breaks(\n    unit_price: int, quantities: tuple[int, ...] = (1, 5, 20)\n) -> dict[int, int]:\n    \"\"\"Price for a few sample quantities, handy for a price list.\"\"\"\n    return {quantity: compute_price(unit_price, quantity) for quantity in quantities}\n\n\n@lru_cache(maxsize=256)\ndef coupon_percent(code: str) -> int:\n    \"\"\"Percent off for a coupon code; unknown codes are worth nothing.\"\"\"\n    return _COUPONS.get(code.strip().upper(), 0)\n\n\ndef apply_coupon(total: int, code: str) -> int:\n    percent = coupon_percent(code)\n    return total - total * percent // 100\n\n\ndef add_tax(total: int) -> int:\n    return total + total * TAX_PERCENT // 100\n\n\ndef shipping_cost(total: int) -> int:\n    \"\"\"Flat rate, free once the items reach the threshold.\"\"\"\n    return 0 if total >= FREE_SHIPPING_FROM else FLAT_SHIPPING\n","modified":"\"\"\"Pricing rules: bulk discounts, coupons, tax and shipping. Amounts are in cents.\"\"\"\n\nfrom functools import lru_cache\n\n# (minimum quantity, percent off), highest tier first.\nBULK_TIERS = ((50, 20), (10, 10))\nTAX_PERCENT = 8\nFLAT_SHIPPING = 599\nFREE_SHIPPING_FROM = 10_000\n\n_COUPONS = {\"WELCOME5\": 5, \"SPRING10\": 10}\n\n\ndef compute_price(unit_price: int, quantity: int, extra_percent: int = 0) -> int:\n    \"\"\"Price of `quantity` units: the bulk tier and `extra_percent` are both taken off.\"\"\"\n    base = unit_price * quantity\n    percent = extra_percent\n    for minimum, tier_percent in BULK_TIERS:\n        if quantity >= minimum:\n            percent += tier_percent\n            break\n    percent = cap_discount(percent)\n    return base - base * percent // 100\n\n\ndef price_breaks(\n    unit_price: int, quantities: tuple[int, ...] = (1, 5, 20)\n) -> dict[int, int]:\n    \"\"\"Price for a few sample quantities, handy for a price list.\"\"\"\n    return {quantity: compute_price(unit_price, quantity) for quantity in quantities}\n\n\n@lru_cache(maxsize=256)\ndef coupon_percent(code: str) -> int:\n    \"\"\"Percent off for a coupon code; unknown codes are worth nothing.\"\"\"\n    return _COUPONS.get(code.strip().upper(), 0)\n\n\ndef apply_coupon(total: int, code: str) -> int:\n    percent = coupon_percent(code)\n    return total - total * percent // 100\n\n\ndef add_tax(total: int) -> int:\n    return total + total * TAX_PERCENT // 100\n\n\ndef shipping_cost(total: int) -> int:\n    \"\"\"Flat rate, free once the items reach the threshold.\"\"\"\n    return 0 if total >= FREE_SHIPPING_FROM else FLAT_SHIPPING\n\n\ndef cap_discount(percent: int, ceiling: int = 30) -> int:\n    \"\"\"The most the bulk tier and the extra percent may take off together.\"\"\"\n    return min(percent, ceiling)\n","lines_added":6,"lines_removed":0},"node_ids":["shop.pricing:compute_price"],"graph":{"nodes_added":[{"id":"shop.pricing:cap_discount","kind":"function","name":"cap_discount","qualname":"cap_discount","path":"shop/pricing.py","start_line":53,"end_line":55,"parent_id":"shop.pricing","is_test":false}],"nodes_modifi