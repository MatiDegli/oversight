+def kwargs_decorator(func):
+    """Allow a decorator to be used bare or configured with keyword options."""
+    @functools.wraps(func)
+    def decorate(*args, **kwargs):
+        if len(args) > 1 or (args and not callable(args[0])):
+            raise TypeError('expected at most one callable positional argument')
+        if args:
+            return func(args[0], **kwargs)
+        return lambda obj: func(obj, **kwargs)
