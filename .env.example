# Copy to .env and fill in the values. .env is gitignored and never committed.
# Muse Spark through the Meta Model API: the product's agents and the API probe only.
META_API_KEY=
# Muse Spark Open through Baseten, for agent B.
BASETEN_API_KEY=
# Optional: where the backend listens. Invalid ports stop startup.
# make dev/replay resolve these from the environment over .env and export them to both servers.
OVERSIGHT_HOST=127.0.0.1
OVERSIGHT_PORT=8710
# Optional extra loopback HTTP origin; empty means unset on the backend.
# make dev/replay fall back to 5710; make shots supplies its own free port; make demo clears it.
# Must be 1-65535 and distinct from OVERSIGHT_PORT. No CORS or remote authorities are enabled.
OVERSIGHT_VITE_PORT=
# Optional: the preset layout file, {node_id: {x, y}}; empty means fixtures/layouts/demo-repo.json.
OVERSIGHT_LAYOUT=
# The model agents run on: muse-spark (Meta, spends credits) or fake (the scripted model, free).
OVERSIGHT_AGENT_MODEL=muse-spark
# With fake: the script it plays, relative to the repository root.
OVERSIGHT_FAKE_SCRIPT=fixtures/fake-model/document-apply-coupon.json
# Agent B's model: muse-spark, muse-spark-open (Baseten) or fake; empty means agent A's model.
OVERSIGHT_AGENT_MODEL_B=
# With fake on B: its own script. A fake B without one is not offered, so B never repeats A's edit.
OVERSIGHT_FAKE_SCRIPT_B=fixtures/fake-model/document-restock.json
# The spending brake. No defaults: if any of these is missing, not a number or not positive, every
# Muse Spark start is refused. The budget is in US dollars: starts warn from 50% (75) and 80% (120)
# and are refused above 90% (135). Prices are US dollars per million tokens for
# muse-spark-1.3-contributor; cached input is priced as fresh input, an upper bound.
OVERSIGHT_BUDGET_USD=150
MUSE_SPARK_INPUT_USD_PER_M=0.10
MUSE_SPARK_OUTPUT_USD_PER_M=0.20

# Cross-review defaults off; PR1 only provides its core/configuration (no proposal wiring yet).
OVERSIGHT_CROSS_REVIEW=false
# Optional second fake profile: OVERSIGHT_AGENT_MODEL_B=fake-b (model fake-scripted-b).
# Reviewer scripts are named for the REVIEWER, separate from both agents' edit scripts.
# Reviewer fake (slot A) reviews author fake-b (slot B).
OVERSIGHT_REVIEWER_FAKE_SCRIPT=
# Reviewer fake-b (slot B) reviews author fake (slot A).
OVERSIGHT_REVIEWER_FAKE_B_SCRIPT=
