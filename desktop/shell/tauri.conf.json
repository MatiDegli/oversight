{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oversight",
  "version": "0.1.0",
  "identifier": "dev.oversight.desktop",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../packaging/stage/app/": "app/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "displayLanguageSelector": false,
        "installerHooks": "../packaging/installer-hooks.nsh"
      }
    }
  }
}
